<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CardexMobile.ViewModels"
             x:Class="CardexMobile.Pages.StatsPage"
             x:DataType="vm:CollectionPageViewModel"
             Title="Stats"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Grid à 3 colonnes (icône / texte / repère vide de même largeur) pour que le TEXTE soit
         visuellement centré dans la barre de titre, pas le bloc icône+texte dans son ensemble. -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="32,Auto,32" HorizontalOptions="Center">
            <Image Grid.Column="0" Source="stats_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="Stats" TextColor="White" FontAttributes="Bold" FontSize="18" Margin="10,0" VerticalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="0,8,0,24">

                <Label Text="No stats yet — start collecting cards first."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalOptions="Center"
                       Padding="16,24"
                       IsVisible="{Binding HasNoStats}"/>

                <!-- Pas de second BindingContext ici : toutes les bindings pointent directement vers
                     Stats.X depuis le DataType de la page (CollectionPageViewModel), pour éviter toute
                     ambiguïté de résolution. -->
                <VerticalStackLayout IsVisible="{Binding HasStats}"
                                     Padding="16,8,16,14"
                                     Spacing="10">

                    <Label TextColor="{StaticResource TextPrimary}" FontSize="14" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="You have "/>
                                <Span Text="{Binding Stats.TotalOwnedCards}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" total cards, spread across "/>
                                <Span Text="{Binding Stats.TotalSets}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" sets."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label TextColor="{StaticResource TextPrimary}" FontSize="14" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Of those, "/>
                                <Span Text="{Binding Stats.TotalHoloCards}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" are holo."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label TextColor="{StaticResource TextPrimary}" FontSize="14" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Out of the "/>
                                <Span Text="{Binding Stats.SetsBegun}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" sets you've begun, "/>
                                <Span Text="{Binding Stats.SetsComplete}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" are complete."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- FlexLayout plutôt que FormattedText unique : l'icône doit être collée au nom
                         du Pokémon (pas au début de la phrase), ce qui impose de couper le texte en
                         deux Labels de part et d'autre de l'Image (un Span ne peut pas contenir de vue). -->
                    <FlexLayout Wrap="Wrap" AlignItems="Center" IsVisible="{Binding StatsSingleMode}">
                        <Label Text="Your most-collected Pokémon is "
                               TextColor="{StaticResource TextPrimary}" FontSize="14" VerticalOptions="Center"/>
                        <Image Source="{Binding Stats.TopPokemonSpriteUrl}"
                               WidthRequest="32" HeightRequest="32"
                               IsVisible="{Binding Stats.HasTopPokemonSprite}"
                               VerticalOptions="Center"
                               Margin="0,0,2,0"/>
                        <Label TextColor="{StaticResource TextPrimary}" FontSize="14" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Stats.TopPokemonName}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                    <Span Text=" with "/>
                                    <Span Text="{Binding Stats.TopPokemonCount}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                    <Span Text=" cards."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </FlexLayout>

                    <!-- Mode "équipe" : les 6 Pokémon les plus collectés, façon équipe de combat.
                         FlexLayout Wrap plutôt qu'une grille stricte : BindableLayout ne supporte
                         pas de layout en colonnes (GridItemsLayout est réservé à CollectionView). -->
                    <Label Text="Your team of favourite Pokémon is :"
                           TextColor="{StaticResource TextPrimary}" FontSize="14" LineBreakMode="WordWrap"
                           IsVisible="{Binding StatsTeamMode}"/>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Stats.TopPokemonTeam}"
                                IsVisible="{Binding StatsTeamMode}"
                                Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PokemonTeamMember">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2" WidthRequest="60" Margin="0,0,6,8">
                                    <Image Source="{Binding SpriteUrl}" WidthRequest="34" HeightRequest="34"
                                           IsVisible="{Binding HasSprite}" HorizontalOptions="Center"/>
                                    <Label Text="{Binding Name}" TextColor="{StaticResource TextPrimary}"
                                           FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                                    <Label TextColor="{StaticResource WantedColor}" FontSize="10" HorizontalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="×"/>
                                                <Span Text="{Binding Count}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label TextColor="{StaticResource TextPrimary}" FontSize="14" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="You've unlocked "/>
                                <Span Text="{Binding Stats.UnlockedAchievements}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text=" achievements out of "/>
                                <Span Text="{Binding Stats.TotalAchievements}" FontAttributes="Bold" TextColor="{StaticResource WantedColor}"/>
                                <Span Text="."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="MOST-COMPLETED SERIES" TextColor="{StaticResource TextSecondary}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" Margin="0,8,0,0"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats.TopCategories}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeriesCompletionStat">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding SeriesName}" TextColor="{StaticResource TextPrimary}" FontSize="13"/>
                                    <Label Grid.Column="1" TextColor="{StaticResource WantedColor}" FontSize="13" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PercentText}"/>
                                                <Span Text=" ("/>
                                                <Span Text="{Binding Owned}"/>
                                                <Span Text="/"/>
                                                <Span Text="{Binding Total}"/>
                                                <Span Text=")"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="COLLECTION BY RARITY" TextColor="{StaticResource TextSecondary}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" Margin="0,8,0,0"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats.RarityBreakdown}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RarityStat">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Rarity}" TextColor="{StaticResource TextPrimary}" FontSize="13"/>
                                    <Label Grid.Column="1" TextColor="{StaticResource HighlightColor}" FontSize="13" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Count}"/>
                                                <Span Text=" ("/>
                                                <Span Text="{Binding PercentText}"/>
                                                <Span Text=")"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
